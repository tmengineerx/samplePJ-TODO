<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="sample.common.dao.mapper.LoginMapper">

    <!-- ユーザー名で1件取得（ログイン認証用） -->
    <select id="findByUsername" resultType="sample.common.dao.entity.Login">
    	SELECT *
    	FROM login
    	WHERE username = #{username}
    </select>
		
    <!-- 登録 -->
	<insert id="insert">
		INSERT INTO login(
			username,
			password
		)
		VALUES(
			#{username},
			#{password}
		)
	</insert>
</mapper>